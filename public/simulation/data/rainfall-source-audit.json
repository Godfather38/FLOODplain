  "findings": {
    "encoding": "Scheduled September 2014 p1h writer computes nonlinear image but stores val.astype(int) in uint8 output. Reader has already divided by header var_scale. Nonzero byte is truncated integer mm, not the current palette. p24h writes its encoded image.",
    "missing": "Historical p1h writer stored integer mm, bypassing its palette conversion. Zero cannot distinguish dry, sub-mm truncation, or missing data: retained as null. Raw NSSL headers were not obtained, so other cast/wrap artifacts cannot be ruled out. Not calibrated or complete rainfall forcing.",
    "geometry": "Original world-file centers (-130,55) differ from corrected native centers (-129.995,54.995). Both sampling interpretations are reported; correction shifts coordinates, not rainfall values.",
    "repetition": {
      "hourlyRawFiles": 72,
      "uniqueRawHashes": 72,
      "embeddedPngTimestamps": "No timestamp metadata in inspected 18Z PNG; archive filenames and scheduled UTC process provide timing evidence, not raw-header verification."
    },
    "timeWindow": "2014-09-08 07Z to 2014-09-09 07Z, same interval as Arizona Sep 8 and p24h endpoint. No timezone shift or overlapping sum.",
