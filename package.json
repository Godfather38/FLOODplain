{
  "name": "floodplain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Morning flood check for the roads out of Avra Valley, AZ.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:worker": "node tools/build_worker.mjs",
    "check:worker-package": "wrangler deploy --dry-run --config wrangler.jsonc",
    "preview:worker": "node worker/serve.mjs",
    "test:worker": "node --test test/cloudflare-worker.test.js test/az511.test.js test/road-event-reconciliation.test.js test/worker-site.test.js",
    "build:gas": "node tools/build_gas.mjs",
    "build:policies": "node tools/build-policies.mjs",
    "test:sms-browser": "node e2e/sms-compliance.mjs",
    "test:browser": "node e2e/smoke.mjs",
    "serve": "python3 -m http.server -d public 8080"
  },
  "devDependencies": {
    "acorn": "^8.14.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.49.1",
    "wrangler": "4.157.0"
  }
}
