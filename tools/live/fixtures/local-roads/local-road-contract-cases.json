{
 "about": "Shared contract v2 cases for local-road-forecast.json. The same file is in the model branch (tools/live/fixtures/local-roads/) and the app (test/fixtures/), next to local-road-stations-sample.json and local-road-forecast-sample.json. Each case applies ops to the forecast sample. expect: ok = the app shows every station and the publish verifier accepts; unreadable = the app drops exactly one listed station and counts it, and the verifier rejects the file; reject = the app shows nothing and the verifier rejects. Synthetic, not model output.",
 "ops": "set path value | add path value (number added) | delete path | pop path | dropEntry at | swapEntries at [a,b] | insertEntry at entry{column: value}. path is a list of keys and array positions in the forecast sample.",
 "cases": [
  {"name": "base", "expect": "ok", "ops": []},
  {"name": "overWithSomeFramesMissing", "expect": "ok", "ops": [{"op": "set", "path": ["listed", "unknownFrames", 0], "value": 3}]},
