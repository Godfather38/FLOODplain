  {"name": "overEveryFrameMissing", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "unknownFrames", 0], "value": 35}]},
  {"name": "overNullUnknownFrames", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "unknownFrames", 0], "value": null}]},
  {"name": "belowAboveRoad", "expect": "unreadable", "ops": [{"op": "add", "path": ["listed", "maxWseCm", 2], "value": 100}, {"op": "add", "path": ["listed", "maxOverCm", 2], "value": 100}]},
  {"name": "belowNotWseMinusRoad", "expect": "unreadable", "ops": [{"op": "add", "path": ["listed", "maxOverCm", 2], "value": -1}]},
  {"name": "belowWithFirstTime", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "firstOverMin", 2], "value": 10}]},
