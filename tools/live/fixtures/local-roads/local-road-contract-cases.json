  {"name": "summaryUnknown", "expect": "reject", "ops": [{"op": "set", "path": ["summary", "unknown"], "value": 0}, {"op": "add", "path": ["summary", "dry"], "value": 2}]},
  {"name": "droppedEntryWouldBeDry", "expect": "reject", "ops": [{"op": "dropEntry", "at": 0}]}
 ]
