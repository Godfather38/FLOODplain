  {"name": "belowZeroCellSize", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "cellSizeM", 2], "value": 0}]},
  {"name": "unknownWithWater", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "maxWseCm", 10], "value": 70000}]},
  {"name": "unknownWithFirstTime", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "firstOverMin", 10], "value": 60}]},
  {"name": "unknownNoMissingFrames", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "unknownFrames", 10], "value": 0}]},
  {"name": "unknownMoreMissingThanFrames", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "unknownFrames", 10], "value": 36}]},
  {"name": "unknownNoCellSize", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "cellSizeM", 10], "value": null}]},
  {"name": "noCellWithCellSize", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "cellSizeM", 12], "value": 6.25}]},
