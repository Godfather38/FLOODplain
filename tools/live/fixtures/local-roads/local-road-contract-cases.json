  {"name": "noListed", "expect": "reject", "ops": [{"op": "delete", "path": ["listed"]}]},
  {"name": "raggedColumns", "expect": "reject", "ops": [{"op": "pop", "path": ["listed", "maxWseCm"]}]},
  {"name": "unknownStateCode", "expect": "reject", "ops": [{"op": "set", "path": ["listed", "state", 0], "value": 7}]},
  {"name": "indexUnsorted", "expect": "reject", "ops": [{"op": "swapEntries", "at": [0, 1]}]},
  {"name": "indexRepeated", "expect": "reject", "ops": [{"op": "set", "path": ["listed", "index", 1], "value": 0}]},
  {"name": "indexOutOfRange", "expect": "reject", "ops": [{"op": "set", "path": ["listed", "index", 13], "value": 20}]},
  {"name": "indexNotInteger", "expect": "reject", "ops": [{"op": "set", "path": ["listed", "index", 13], "value": 18.5}]},
  {"name": "noHeightStationListed", "expect": "reject", "ops": [{"op": "insertEntry", "at": 3, "entry": {"index": 3, "state": 3, "maxWseCm": null, "maxOverCm": null, "firstOverMin": null, "cellSizeM": null, "unknownFrames": null}}, {"op": "add", "path": ["summary", "noCell"], "value": 1}, {"op": "add", "path": ["summary", "noRoadHeight"], "value": -1}]},
  {"name": "noSummary", "expect": "reject", "ops": [{"op": "delete", "path": ["summary"]}]},
