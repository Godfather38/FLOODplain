  {"name": "noCellWithWater", "expect": "unreadable", "ops": [{"op": "set", "path": ["listed", "maxWseCm", 12], "value": 70000}]},

  {"name": "schemaVersion", "expect": "reject", "ops": [{"op": "set", "path": ["schemaVersion"], "value": 1}]},
  {"name": "kind", "expect": "reject", "ops": [{"op": "set", "path": ["kind"], "value": "live_all_route_road_forecast"}]},
  {"name": "status", "expect": "reject", "ops": [{"op": "set", "path": ["status"], "value": "complete"}]},
