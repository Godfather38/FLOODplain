{
  "name": "floodplain",
  "account_id": "e2f4d2bba324bf47a074890619e83af3",
  "main": "worker/site.js",
  "compatibility_date": "2026-11-03",
  "build": { "command": "npm run build:worker" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "PUBLIC_LIVE": "false", "AZ511_ENABLED": "false" },
  "triggers": { "crons": [] }
}
