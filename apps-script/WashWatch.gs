// ===== public/logic.js =====
// Pure rules: turn sensor data into a level + plain-English reason for each
// failure point, then for each route. No DOM or network so it runs under node --test.

const LEVELS = ['ok', 'watch', 'caution', 'danger'];
const rank = (lvl) => (lvl === 'unknown' ? 1.5 : LEVELS.indexOf(lvl));
const worst = (levels) => levels.reduce((a, b) => (rank(b) > rank(a) ? b : a), 'ok');
const WINDOW_WORDS = { m10: '10 min', m30: '30 min', h1: '1 hour', h3: '3 hours', h6: '6 hours', d1: '24 hours' };
const fmtIn = (v) => `${v.toFixed(2)}"`;
const siteName = (names, id) => names[id]?.name ?? names[id] ?? id;
const fmtCfs = (n) => (n >= 100 ? Math.round(n).toLocaleString('en-US') : String(Math.round(n * 10) / 10));

// ---------- USGS ----------

// OGC `continuous` items -> { '00060': [{t, v}], '00065': [...] }, oldest first.
function parseContinuous(json) {
  const series = {};
  for (const f of json?.features ?? []) {
    const p = f.properties ?? {};
    const t = Date.parse(p.time);
    const v = Number(p.value);
    if (!p.parameter_code || !Number.isFinite(t) || p.value == null || p.value === '' || !Number.isFinite(v)) continue;
    (series[p.parameter_code] ??= []).push({ t, v });
  }
  for (const s of Object.values(series)) s.sort((a, b) => a.t - b.t);
  return series;
}

// Least-squares change per hour over the trailing hour (null if < 3 points).
function ratePerHour(points, windowMs = 3_600_000) {
  if (!points?.length) return null;
  const end = points[points.length - 1].t;
  const pts = points.filter((p) => end - p.t <= windowMs);
  if (pts.length < 3) return null;
  const xs = pts.map((p) => (p.t - end) / 3_600_000);
  const ys = pts.map((p) => p.v);
  const mx = xs.reduce((a, b) => a + b) / xs.length;
  const my = ys.reduce((a, b) => a + b) / ys.length;
  let num = 0;
  let den = 0;
  xs.forEach((x, i) => { num += (x - mx) * (ys[i] - my); den += (x - mx) ** 2; });
  return den ? num / den : null;
}

// Latest flow (cfs), its trend, and whether it's fresh.
function summarizeFlow(series, now, staleMs) {
  const q = series?.['00060'] ?? [];
  const last = q[q.length - 1];
  if (!last || now - last.t > staleMs) return { fresh: false };
  const rate = ratePerHour(q);
  const risingFast = rate != null && last.v >= 50 && rate > Math.max(last.v * 0.5, 100);
  return { fresh: true, cfs: last.v, rate, risingFast, time: last.t };
}

// ---------- the four checks ----------

// 1. River bridges, from USGS flow at the given gauges (worst one wins).
function checkRiver(flows, siteIds, names, R) {
  const parts = siteIds.map((id) => ({ id, f: flows[id] })).filter((p) => p.f?.fresh);
  if (!parts.length) return { level: 'unknown', why: 'no live river gauge reading' };
  let out = { level: 'ok', why: `river at normal level (${parts.map((p) => `${fmtCfs(p.f.cfs)} cfs`).join(', ')})` };
  for (const { id, f } of parts) {
    const at = `${fmtCfs(f.cfs)} cfs at ${siteName(names, id)}`;
    let c;
    if (f.cfs >= R.dangerCfs) c = { level: 'danger', why: `${at}: the 2014 flood that went over the Trico bridge was 12,000-21,000 cfs` };
    else if (f.cfs >= R.cautionCfs || (f.risingFast && f.cfs >= R.watchCfs)) c = { level: 'caution', why: `${at}${f.risingFast ? ' and rising fast' : ''}: big flood flow. Bridges get closed at levels like this` };
    else if (f.cfs >= R.watchCfs || f.risingFast) c = { level: 'watch', why: `${at}${f.risingFast ? ' and rising' : ''}: storm water under the bridge` };
    if (c && rank(c.level) > rank(out.level)) out = c;
  }
  return out;
}

// Upstream creeks that reach the river bridges hours later.
function checkRiverEarly(flows, siteIds, names, R) {
  const running = siteIds.filter((id) => flows[id]?.fresh && flows[id].cfs >= R.earlyCfs);
  if (!running.length) return null;
  return { level: 'watch', why: `${running.map((id) => `${siteName(names, id)} at ${fmtCfs(flows[id].cfs)} cfs`).join(', ')}: that water reaches the Santa Cruz bridges in a few hours` };
}

// 2. Rain in inches at ALERT gauges against a rule set; the heaviest gauge wins.
function checkRain(snapshot, gaugeIds, rules, names, now, staleMs) {
  const gauges = (snapshot?.rain ?? []).filter((g) => gaugeIds.includes(g.site));
  // Use the latest readings we have, up to a day old, and say how old they are.
  const fresh = gauges.filter((g) => g.last_rpt && !g.maintenance && now - Date.parse(g.last_rpt) <= Math.max(staleMs, 24 * 3_600_000));
  if (!fresh.length) return { level: 'unknown', why: 'no rain gauge reading' };
  const ageMin = snapshot.fetched_at ? (now - Date.parse(snapshot.fetched_at)) / 60_000 : 0;
  const asOf = ageMin > 45 ? ` (rain readings from ${new Date(Date.parse(snapshot.fetched_at)).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Phoenix' })})` : '';
  const most = (w) => Math.max(...fresh.map((g) => g.in?.[w] ?? 0));
  const detail = `last 1 h ${fmtIn(most('h1'))} · 3 h ${fmtIn(most('h3'))} · 6 h ${fmtIn(most('h6'))} · 24 h ${fmtIn(most('d1'))}`
    + ` (wettest of ${fresh.map((g) => names[g.site] ?? g.name).join(', ')})`;
  for (const level of ['danger', 'caution', 'watch']) {
    for (const [win, limit] of Object.entries(rules[level] ?? {})) {
      const hit = fresh
        .filter((g) => g.in?.[win] != null && g.in[win] >= limit)
        .sort((a, b) => b.in[win] - a.in[win])[0];
      if (hit) return { level, detail, why: `${fmtIn(hit.in[win])} of rain in the last ${WINDOW_WORDS[win]} at ${names[hit.site] ?? hit.name}${asOf}` };
    }
  }
  const h6 = most('h6');
  return { level: 'ok', detail, why: (h6 > 0 ? `light rain only (${fmtIn(h6)} in the last 6 hours)` : 'no rain in the last 6 hours') + asOf };
}

// 3. A wash's own flow sensors (ALERT stream sensors + USGS).
function checkWash(snapshot, flows, wash, kind, now, staleMs, names) {
  const readings = [];
  for (const id of wash.alert ?? []) {
    const s = (snapshot?.stream ?? []).find((x) => x.site === id);
    if (s && s.flow_cfs != null && s.last_rpt && now - Date.parse(s.last_rpt) <= staleMs) readings.push({ name: s.name.replace(/ \(PT\)$/, ''), cfs: s.flow_cfs });
  }
  for (const id of wash.usgs ?? []) {
    if (flows[id]?.fresh) readings.push({ name: siteName(names, id), cfs: flows[id].cfs, risingFast: flows[id].risingFast });
  }
  if (!readings.length) return { level: 'unknown', why: 'no wash flow sensor reading' };
  const top = readings.sort((a, b) => b.cfs - a.cfs)[0];
  if (top.cfs < 1) return { level: 'ok', why: 'Brawley Wash upstream is dry' };
  const at = `${fmtCfs(top.cfs)} cfs in ${top.name}`;
  if (kind === 'dip') {
    return top.cfs >= 500 || top.risingFast
      ? { level: 'danger', why: `${at}: a flood is coming down the wash toward this crossing` }
      : { level: 'caution', why: `${at}: water is coming down the wash toward this crossing` };
  }
  return top.cfs >= 2000 || top.risingFast
    ? { level: 'caution', why: `${at}: a large flow is coming toward this bridge` }
    : { level: 'watch', why: `${at}: water will pass under this bridge` };
}

// 4. Pima County's own barricade points near this spot.
const metres = (a, b) => {
  const ky = 111_320;
  const kx = ky * Math.cos((a.lat * Math.PI) / 180);
  return Math.hypot((a.lon - b.lon) * kx, (a.lat - b.lat) * ky);
};
function nearbyClosures(fp, closures, radiusM) {
  return (closures ?? []).filter((c) => metres(fp, c) <= radiusM);
}
function checkClosures(points) {
  if (!points.length) return null;
  const when = (p) => (p.updated ? ` (updated ${p.updated})` : '');
  const detail = points.map((p) => `${p.location}: ${p.status}${when(p)}`).join(' · ');
  const closed = points.find((p) => /clos/i.test(p.status));
  if (closed) return { level: 'danger', detail, why: `County says CLOSED: ${closed.location}${when(closed)}` };
  const careful = points.find((p) => /caution/i.test(p.status));
  if (careful) return { level: 'caution', detail, why: `County says Proceed with Caution: ${careful.location}${when(careful)}` };
  return { level: 'ok', detail, why: 'county barricade point marked Open', official: true };
}

// NWS warnings in effect for Avra Valley.
function checkNws(alerts, kind) {
  // NWS alerts cover the whole county, so they only nudge the spots that flood
  // first (dips). A Flood Watch ("possible later") changes nothing; it's shown as a note.
  if (!alerts) return null;
  const names = alerts.map((a) => a.event);
  if (names.some((e) => /Flash Flood Warning/i.test(e))) {
    return { level: kind === 'dip' ? 'caution' : 'watch', why: 'NWS Flash Flood Warning in effect: flooding is happening or about to somewhere in the area' };
  }
  if (kind === 'dip' && names.some((e) => /Flood (Warning|Advisory)|Flash Flood Statement/i.test(e))) {
    return { level: 'watch', why: `NWS ${names.find((e) => /Flood/i.test(e))} in effect for the area` };
  }
  return null;
}

// ---------- combine ----------

function rateFailurePoint(fp, d, cfg) {
  const checks = [];
  const { now } = d;
  const closurePts = nearbyClosures(fp, d.closures, cfg.CLOSURE_RADIUS_M);
  const closure = d.closures ? checkClosures(closurePts) : null;
  if (closure) checks.push({ src: 'county', ...closure });
  const nws = checkNws(d.nws, fp.kind);
  if (nws) checks.push({ src: 'nws', ...nws });
  if (fp.river) {
    checks.push({ src: 'river', ...checkRiver(d.flows, fp.river, cfg.USGS_SITES, cfg.RIVER) });
    const early = checkRiverEarly(d.flows, cfg.RIVER_EARLY, cfg.USGS_SITES, cfg.RIVER);
    if (early) checks.push({ src: 'river-early', ...early });
  }
  if (fp.wash) checks.push({ src: 'wash', ...checkWash(d.alert, d.flows, fp.wash, fp.kind, now, cfg.STALE_MS, cfg.USGS_SITES) });
  for (const [ruleName, ids] of Object.entries(fp.rain ?? {})) {
    const c = d.alert
      ? checkRain(d.alert, ids, cfg.RAIN[ruleName], cfg.RAIN_GAUGES, now, cfg.STALE_MS)
      : { level: 'unknown', why: 'rain gauges unreachable right now' };
    // Rain upstream of a bridge means water will pass *under* it. That's a heads-up,
    // not a reason to avoid the road. The wash flow sensors decide anything worse.
    if (fp.kind === 'bridge' && rank(c.level) > rank('watch') && c.level !== 'unknown') {
      c.level = 'watch';
      c.why += ': water will pass under this bridge';
    }
    checks.push({ src: `rain-${ruleName}`, ...c });
  }
  // Always a rating: it comes from whatever sources answered. A source that didn't
  // answer is listed in the details ("unreachable"), but never turns the rating into "?".
  const known = checks.filter((c) => c.level !== 'unknown');
  let level = known.length ? worst(known.map((c) => c.level)) : 'ok';
  if (!known.length) checks.unshift({ src: 'none', level: 'ok', why: 'No live readings right now, and nothing reported against it' });
  // Shallow spots per local knowledge: Silverbell drainage, the big flat dip on Ina.
  if ((fp.kind === 'road' || fp.kind === 'flat') && level === 'danger') level = 'caution';
  // Lead with a measurement when one exists; the county "Open" flag is often days old.
  // Lead with the most specific source at that level: county closure, then local measurements, then NWS.
  const pref = ['county', 'wash', 'rain-local', 'river', 'rain-road', 'rain-basin', 'river-early', 'nws'];
  const atLevel = checks.filter((c) => c.level === level && !(c.official && level === 'ok'));
  atLevel.sort((a, b) => pref.indexOf(a.src) - pref.indexOf(b.src));
  const lead = atLevel[0] ?? checks.find((c) => c.level === level) ?? checks[0];
  return { id: fp.id, name: fp.name, short: fp.short, where: fp.where, kind: fp.kind, level, why: lead?.why ?? 'no data', checks, closurePts };
}

function rateRoutes(routeFeatures, fpResults, fps) {
  return routeFeatures.map((f) => {
    const id = f.properties.id;
    const pts = fps.filter((fp) => fp.routes.includes(id)).map((fp) => fpResults[fp.id]);
    return { id, name: f.properties.name, minutes: f.properties.minutes, km: f.properties.km, level: worst(pts.map((p) => p.level)), points: pts };
  });
}

// Fastest route that is ok/watch, otherwise the least-bad. Unknown never counts as clear.
function recommend(rated) {
  const order = [...rated].sort((a, b) => rank(a.level) - rank(b.level) || a.minutes - b.minutes);
  const best = order[0];
  return { best, clear: best && rank(best.level) <= rank('watch'), order };
}

// Google Maps link that forces the chosen roads with waypoints (phones allow up to 3).
//   toI10: from wherever you are, via the route, to I-10 (or on to `destination`).
//   valley: from wherever you are (e.g. work), onto I-10, off at this route's ramp,
//          back along the route to Trico & El Tiro, the heart of the valley.
const VALLEY_HUB = [32.4295, -111.3045];
function googleMapsUrl(nav, destination, direction = 'toI10') {
  let pts;
  let dest;
  if (direction === 'valley') {
    pts = [nav.ramp, ...[...nav.via].reverse()].slice(0, 3);
    dest = (nav.hub || VALLEY_HUB).join(',');
  } else {
    pts = [...nav.via, ...(destination ? [nav.ramp] : [])].slice(0, 3);
    dest = destination || nav.ramp.join(',');
  }
  const u = new URL('https://www.google.com/maps/dir/');
  u.searchParams.set('api', '1');
  u.searchParams.set('destination', dest);
  u.searchParams.set('waypoints', pts.map((p) => p.join(',')).join('|'));
  u.searchParams.set('travelmode', 'driving');
  return u.toString();
}

// A small 1-5 "risk factor" for display. It summarizes the level; it is not a probability.
//   1 nothing pointing at water · 2 some water around · 3 water likely near the road
//   4 several signs agree water is at the road · 5 closed or flood running · null unknown
function riskScore(result) {
  switch (result.level) {
    case 'ok': return 1;
    case 'watch': return 2;
    case 'caution': return result.checks.filter((c) => c.level === 'caution' || c.level === 'danger').length >= 2 ? 4 : 3;
    case 'danger': return 5;
    default: return null;
  }
}
function routeScore(route) {
  const scores = route.points.map(riskScore);
  if (route.level === 'unknown') return null;
  return Math.max(...scores.filter((x) => x != null), 1);
}

// The angel: plain "good signs" for a route, from every check that came back clear.
function goodSigns(route, nwsQuiet) {
  // A sign only counts as good if nothing of the same kind on this route says otherwise.
  const kind = (src) => (src.startsWith('rain') ? 'rain' : src === 'river-early' ? 'river' : src);
  const checks = route.points.flatMap((p) => p.checks);
  const bad = new Set(checks.filter((c) => c.level !== 'ok').map((c) => kind(c.src)));
  const ok = checks.filter((c) => c.level === 'ok' && !bad.has(kind(c.src)));
  const out = [];
  const add = (t) => { if (!out.includes(t)) out.push(t); };
  if (ok.some((c) => c.src === 'river')) add('the Santa Cruz is at its everyday flow');
  if (ok.some((c) => c.src === 'wash')) add('Brawley Wash upstream is dry');
  const rain = ok.filter((c) => c.src.startsWith('rain'));
  if (rain.length) add(rain.every((c) => /^no rain/.test(c.why)) ? 'no rain in the last 6 hours' : 'only light rain lately');
  if (ok.some((c) => c.src === 'county')) add('county barricades on it are marked Open');
  if (nwsQuiet) add('no weather-service flood alerts');
  return out;
}

// What's working against a route, worst first, one line per stretch.
function againstIt(route) {
  const order = { danger: 0, caution: 1, unknown: 2, watch: 3 };
  return route.points
    .filter((p) => p.level !== 'ok')
    .sort((a, b) => order[a.level] - order[b.level])
    .map((p) => ({ level: p.level, short: p.short, why: p.why }));
}

// ===== public/engine.js =====
// The whole check in one place, independent of where it runs (browser, Node, Google Apps Script).
// Inputs are already-fetched raw responses; output is the rated routes plus a short message.


const WORD = { 1: 'Low', 2: 'Minor', 3: 'Moderate', 4: 'High', 5: 'Severe' };
const RAIN_KEYS = ['m10', 'm30', 'h1', 'h3', 'h6', 'd1', 'd3', 'd7', 'd30'];
const BOX = [-111.50, 32.05, -110.95, 32.56];

// Pima ALERT currain.php / currentstream.php "data" arrays -> the snapshot shape the rules use.
// Same as tools/snapshot_alert.py. ALERT times are Arizona local (UTC-7, no DST).
function alertSnapshot(rainData, streamData, fetchedAt) {
  const inside = (d) => { const x = Number(d.longitude); const y = Number(d.latitude); return x >= BOX[0] && x <= BOX[2] && y >= BOX[1] && y <= BOX[3]; };
  const ours = (d) => inside(d) && (d.source === 'pima' || d.source === 'pinal');
  const iso = (t) => (t ? `${t}-07:00` : null);
  const num = (v) => { const n = Number(v); return Number.isFinite(n) && n > -90 ? n : null; };
  return {
    fetched_at: new Date(fetchedAt).toISOString(),
    rain: (rainData ?? []).filter(ours).map((d) => ({
      site: d.site, name: String(d.name).trim(), lat: Number(d.latitude), lon: Number(d.longitude), last_rpt: iso(d.last_rpt),
      maintenance: !!d.UnderMaintenance, in: Object.fromEntries(RAIN_KEYS.map((k, i) => [k, num((d.rain ?? [])[i])])),
    })),
    stream: (streamData ?? []).filter(ours).map((d) => ({
      site: d.site, name: String(d.name).trim(), lat: Number(d.latitude), lon: Number(d.longitude), last_rpt: iso(d.last_rpt),
      maintenance: !!d.UnderMaintenance, stage_ft: num(d.stage), flow_cfs: num(d.flow),
    })),
  };
}

// raw = { now, usgs: {site: json|null}, closures: arcgisJson|null, alert: snapshot|null, nws: geojson|null, routes: [features] }
function evaluate(raw, area = 'avra') {
  const now = raw.now;
  const flows = Object.fromEntries(Object.keys(CFG_.USGS_SITES).map((s) => [s, summarizeFlow(raw.usgs?.[s] ? parseContinuous(raw.usgs[s]) : {}, now, CFG_.STALE_MS)]));
  const closures = raw.closures?.features?.map((f) => ({ location: f.attributes.Location?.trim(), status: f.attributes.Status ?? '', updated: f.attributes.timeUpdated, lat: f.geometry.y, lon: f.geometry.x })) ?? null;
  const nws = raw.nws ? (raw.nws.features ?? []).map((f) => ({ event: f.properties.event })) : null;
  const d = { now, flows, closures, alert: raw.alert, nws };
  const fpResults = Object.fromEntries(CFG_.FAILURE_POINTS.map((fp) => [fp.id, rateFailurePoint(fp, d, cfg)]));
  const routes = raw.routes.filter((f) => (f.properties.area ?? 'avra') === area);
  const rated = rateRoutes(routes, fpResults, CFG_.FAILURE_POINTS).map((r) => ({ ...r, score: routeScore(r) }));
  const { best, order } = recommend(rated);
  const missing = [!closures && 'county', !raw.alert && 'rain', !Object.values(flows).some((f) => f.fresh) && 'river'].filter(Boolean);
  return { rated, best, order, missing, ...message(best, order, rated, missing, now, area) };
}

function message(best, order, rated, missing, now, area = 'avra') {
  const areaName = area === 'avra' ? '' : ` (${(CFG_.AREAS.find((a) => a.id === area) ?? {}).name})`;
  const name = (r) => CFG_.ROUTE_INFO[r.id].name;
  const issue = (r) => { const a = againstIt(r)[0]; return a ? `${a.short}: ${a.why}` : null; };
  const text = [
    `Wash Watch${areaName}: take ${name(best)} (${best.score}/5 ${WORD[best.score]}, ${Math.round(best.minutes)} min).`,
    issue(best) ? `Watch for ${issue(best)}.` : null,
    `Others: ${order.filter((r) => r !== best).map((r) => `${name(r)} ${r.score}`).join(', ')}.`,
    ...order.filter((r) => r !== best && r.score >= 4).map((r) => `${name(r)}: ${issue(r)}.`),
    missing.length ? `(No live ${missing.join('/')} data.)` : null,
    'https://godfather38.github.io/FLOODplain/',
  ].filter(Boolean).join(' ');
  return {
    at: new Date(now).toISOString(),
    text,
    sms: text.replace(/^Wash Watch(?: \(([^)]+)\))?: /, (m, ar) => (ar ? `${ar}: ` : '')).replace(/ https:\S+/, ''),
    spoken: text.replace(/ https:\S+/, '').replace(/(\d)\/5/g, '$1 out of 5').replace(/–/g, ' and '),
    off: rated.some((r) => r.score >= 2),
    title: `Wash Watch${areaName}: ${name(best)} ${best.score}/5`,
  };
}

// Where to fetch each input from (shared by Node and Apps Script).
function sourceUrls(usgsKey) {
  const q = new URLSearchParams({
    where: '1=1', outFields: 'Location,Status,timeUpdated', returnGeometry: 'true', outSR: '4326', f: 'json',
    geometry: '-111.45,32.25,-111.10,32.50', geometryType: 'esriGeometryEnvelope', inSR: '4326', spatialRel: 'esriSpatialRelIntersects',
  });
  return {
    usgs: Object.fromEntries(Object.keys(CFG_.USGS_SITES).map((s) => [s, `${CFG_.SOURCES.usgs}/collections/continuous/items?f=json&monitoring_location_id=USGS-${s}`
      + '&parameter_code=00060&time=PT6H&limit=500&skipGeometry=true&properties=time,value,parameter_code' + (usgsKey ? `&api_key=${usgsKey}` : '')])),
    closures: `${CFG_.SOURCES.closures}/query?${q}`,
    rain: 'https://alertmap.rfcd.pima.gov/gmap/gmap_files/php/currain.php',
    stream: 'https://alertmap.rfcd.pima.gov/gmap/gmap_files/php/currentstream.php',
    nws: CFG_.SOURCES.nws,
  };
}

const CFG_ = { AREAS, SOURCES, USGS_SITES, STALE_MS, SNAPSHOT_STALE_MS, RIVER, RAIN, RAIN_GAUGES, FAILURE_POINTS, RIVER_EARLY, CLOSURE_RADIUS_M, ROUTE_INFO };
const cfg = CFG_;
const ROUTE_FEATURES = [{"properties":{"id":"trico","area":"avra","name":"Trico Rd -> Trico-Marana Rd -> Marana Rd","minutes":10.4,"km":11.2}},{"properties":{"id":"avra","area":"avra","name":"Avra Valley Rd (I-10 Avra Valley exit)","minutes":19.5,"km":21.1}},{"properties":{"id":"silverbell-north","area":"avra","name":"Silverbell Rd -> Sanders Rd north -> Marana Rd","minutes":16.5,"km":16.5}},{"properties":{"id":"silverbell-south","area":"avra","name":"Silverbell Rd -> Sanders Rd south -> Avra Valley Rd east","minutes":19.7,"km":20.2}},{"properties":{"id":"pr-ina","area":"picture-rocks","name":"Picture Rocks Rd -> Ina Rd","minutes":17.7,"km":19.5}},{"properties":{"id":"pr-twinpeaks","area":"picture-rocks","name":"Sandario Rd -> Twin Peaks Rd","minutes":15.4,"km":16.7}},{"properties":{"id":"pr-avra","area":"picture-rocks","name":"Sandario Rd -> Avra Valley Rd","minutes":15.3,"km":16.6}},{"properties":{"id":"pr-gates","area":"picture-rocks","name":"Sandario Rd -> Kinney Rd -> Gates Pass -> Speedway","minutes":30.4,"km":32.3}}];

// ===== apps-script/Code.gs =====
/**
 * Wash Watch alerts, run as a Google Apps Script web app.
 *
 * - Text sign-ups (phone, times, days, mode) live in a private Google Sheet owned
 *   by the account that deploys this script. Nothing personal goes to GitHub.
 * - Every minute it reads the latest check published by the Wash Watch repo and:
 *     texts everyone whose time (Arizona, any minute) has come, and
 *     posts to the free ntfy topics washwatch-HHMM-{wd|all}-{all|off}.
 *   Missed minutes (the trigger can skip) are caught up, up to 10 minutes back.
 * - Texts go through Twilio when these Script properties are set:
 *     TWILIO_SID, TWILIO_TOKEN, TWILIO_FROM  (any carrier; STOP replies handled by Twilio)
 *   Otherwise they go through Verizon's email-to-text (Verizon numbers only), which
 *   Verizon ends on March 31, 2027. Subscribers and the owner are told on
 *   March 1, 2027 and April 1, 2027.
 *
 * Limits: 2 texts a day per number. An access key (rows the owner adds to the
 * "keys" tab of the private sheet: key | texts_per_day | note) raises that.
 * DAILY_TEXT_BUDGET caps all texts per day so a bill can't run away.
 * People can ask the owner for a key through the app; that arrives as an email
 * to the owner, so the owner's address is never shown publicly.
 *
 * Deploy: Deploy > New deployment > Web app > Execute as: Me, Who has access: Anyone.
 */
const CONFIG = {
  VERDICT_URL: 'https://raw.githubusercontent.com/godfather38/floodplain/data/verdict.json',
  APP_URL: 'https://godfather38.github.io/FLOODplain/',
  GATEWAY: 'vtext.com',
  TZ: 'America/Phoenix',
  HEADS_UP: '2027-03-01',
  ENDED: '2027-04-01',
  MAX_TIMES: 4,
  FREE_PER_DAY: 2,
  DAILY_TEXT_BUDGET: 150,     // all texts, all people, per day (about $1.50/day max on Twilio)
  CODES_PER_NUMBER_PER_DAY: 3,
  REQUESTS_PER_DAY: 10,
  CATCH_UP_MIN: 10,
  NTFY: 'https://ntfy.sh/washwatch',
  MAX_NEW_SIGNUPS_PER_DAY: 40,
};
const HEADER = ['phone', 'times', 'days', 'mode', 'verified', 'code', 'code_sent', 'last_sent', 'created', 'key', 'sent_day', 'sent_count', 'codes_day', 'area'];
const KEYS_HEADER = ['key', 'texts_per_day', 'note'];
// Column numbers (1-based) in the subscribers tab.
const C = { phone: 1, times: 2, days: 3, mode: 4, verified: 5, code: 6, codeSent: 7, lastSent: 8, created: 9, key: 10, sentDay: 11, sentCount: 12, codesDay: 13, area: 14 };
const AREA_IDS = ['avra', 'picture-rocks'];
const validArea_ = (a) => (AREA_IDS.includes(a) ? a : 'avra');

// Run once from the editor (pick "setup" in the toolbar, press Run) if texts don't start on their own.
function setup() { ensureTrigger_(); sheet_(); keysSheet_(); return 'ok'; }

// ---------- web endpoints ----------
function doGet(e) {
  ensureTrigger_();
  // The app asks for the county rain/stream feed through here (the county site blocks browsers).
  if (e && e.parameter && e.parameter.feed === 'alert') {
    computeVerdicts_();
    const snap = CacheService.getScriptCache().get('alert');
    return json_(snap ? JSON.parse(snap) : { error: 'unavailable' });
  }
  return json_({ ok: true, service: 'wash-watch-alerts', sender: twilio_() ? 'any' : 'verizon', freePerDay: CONFIG.FREE_PER_DAY });
}

function doPost(e) {
  ensureTrigger_();
  let body = {};
  try { body = JSON.parse(e.postData.contents); } catch (err) { return json_({ ok: false, error: 'bad request' }); }
  if (body.action === 'request') return json_(request_(body));
  if (body.action === 'push' || body.action === 'pushstop') {
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try { return json_(body.action === 'push' ? push_(body) : pushStop_(body)); } finally { lock.releaseLock(); }
  }
  const phone = String(body.phone || '').replace(/\D/g, '').replace(/^1(?=\d{10}$)/, '');
  if (!/^\d{10}$/.test(phone)) return json_({ ok: false, error: 'Enter a 10-digit US number.' });
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    if (body.action === 'signup') return json_(signup_(phone, body));
    if (body.action === 'confirm') return json_(confirm_(phone, String(body.code || '')));
    if (body.action === 'stop') return json_(stop_(phone));
    return json_({ ok: false, error: 'unknown action' });
  } finally {
    lock.releaseLock();
  }
}

function signup_(phone, b) {
  const key = String(b.key || '').trim();
  const limit = key ? keyLimit_(key) : CONFIG.FREE_PER_DAY;
  if (key && !limit) return { ok: false, error: 'That access key isn\'t valid.' };
  const times = [...new Set((b.times || []).map(String))].filter(validTime_).slice(0, CONFIG.MAX_TIMES);
  if (!times.length) return { ok: false, error: 'Pick at least one time.' };
  if (times.length > limit) {
    return { ok: false, error: `Texts are limited to ${limit} a day${key ? ' for this key' : ' without an access key'}. Pick ${limit} time${limit > 1 ? 's' : ''}, or ask for more below.` };
  }
  const days = validDays_(b.days);
  const mode = b.mode === 'off' ? 'off' : 'all';
  const sh = sheet_();
  const row = findRow_(sh, phone);
  const now = Date.now();
  const today = today_();
  let codesToday = 0;
  if (row) {
    const last = Number(sh.getRange(row, C.codeSent).getValue()) || 0;
    if (now - last < 2 * 60 * 1000) return { ok: false, error: 'A code was just sent. Wait 2 minutes.' };
    const cd = String(sh.getRange(row, C.codesDay).getValue()).split(' ');
    codesToday = cd[0] === today ? Number(cd[1]) || 0 : 0;
    if (codesToday >= CONFIG.CODES_PER_NUMBER_PER_DAY) return { ok: false, error: 'Too many codes for this number today. Try tomorrow.' };
  } else if (newToday_() >= CONFIG.MAX_NEW_SIGNUPS_PER_DAY) {
    return { ok: false, error: 'Too many sign-ups today. Try tomorrow.' };
  }
  const code = String(Math.floor(1000 + Math.random() * 9000));
  const keep = row ? sh.getRange(row, 1, 1, HEADER.length).getValues()[0] : [];
  const values = [phone, times.join(','), days, mode, false, code, now, keep[C.lastSent - 1] || '',
    row ? keep[C.created - 1] : new Date(), key, keep[C.sentDay - 1] || '', keep[C.sentCount - 1] || 0, `${today} ${codesToday + 1}`, validArea_(b.area)];
  if (row) sh.getRange(row, 1, 1, HEADER.length).setValues([values]);
  else sh.appendRow(values);
  text_(phone, `Wash Watch code: ${code}. Enter it in the app to start your texts. If you didn't ask for this, ignore it.`, true);
  return { ok: true, step: 'confirm' };
}

// Someone asking the owner for more texts; goes to the owner's inbox.
function request_(b) {
  const props = PropertiesService.getScriptProperties();
  const today = today_();
  const [day, n] = String(props.getProperty('requests') || '').split(' ');
  const count = day === today ? Number(n) || 0 : 0;
  if (count >= CONFIG.REQUESTS_PER_DAY) return { ok: false, error: 'Too many requests today. Try tomorrow.' };
  const contact = String(b.contact || '').slice(0, 200).trim();
  const message = String(b.message || '').slice(0, 1500).trim();
  if (!contact || !message) return { ok: false, error: 'Add how to reach you and a short message.' };
  props.setProperty('requests', `${today} ${count + 1}`);
  MailApp.sendEmail(Session.getEffectiveUser().getEmail(), 'Wash Watch: request for more texts',
    `From: ${contact}\n\n${message}\n\nTo give them a key, add a row to the "keys" tab of "Wash Watch text subscribers (private)": key | texts_per_day | note.`);
  return { ok: true, step: 'sent' };
}

function keyLimit_(key) {
  const rows = keysSheet_().getDataRange().getValues().slice(1);
  const r = rows.find((x) => String(x[0]).trim() === key);
  return r ? Math.max(1, Math.min(Number(r[1]) || 0, CONFIG.MAX_TIMES)) : 0;
}

function confirm_(phone, code) {
  const sh = sheet_();
  const row = findRow_(sh, phone);
  if (!row || String(sh.getRange(row, C.code).getValue()) !== code) return { ok: false, error: 'That code doesn\'t match.' };
  sh.getRange(row, C.verified).setValue(true);
  const times = String(sh.getRange(row, C.times).getValue()).split(',').map(label_).join(' & ');
  const days = daysLabel_(String(sh.getRange(row, C.days).getValue()));
  text_(phone, `Wash Watch texts are on: ${times}, ${days}. To stop, use Stop texts in the app's Alerts screen.`);
  return { ok: true, step: 'done' };
}

function stop_(phone) {
  const sh = sheet_();
  const row = findRow_(sh, phone);
  if (row) {
    sh.deleteRow(row);
    text_(phone, 'Wash Watch texts stopped.');
  }
  return { ok: true, step: 'stopped' };
}

// ---------- every minute ----------
function tick() {
  const now = new Date();
  const today = Utilities.formatDate(now, CONFIG.TZ, 'yyyy-MM-dd');
  const props = PropertiesService.getScriptProperties();
  if (!twilio_()) sunset_(today, props);

  // Minutes to handle: everything since the last run, at most CATCH_UP_MIN back.
  const nowMin = Math.floor(now.getTime() / 60000);
  const last = Number(props.getProperty('last_min')) || nowMin - 1;
  const from = Math.max(last + 1, nowMin - CONFIG.CATCH_UP_MIN + 1);
  props.setProperty('last_min', String(nowMin));
  if (from > nowMin) return;
  const minutes = [];
  for (let m = from; m <= nowMin; m++) {
    const d = new Date(m * 60000);
    minutes.push({
      hhmm: Utilities.formatDate(d, CONFIG.TZ, 'HH:mm'),
      day: Utilities.formatDate(d, CONFIG.TZ, 'yyyy-MM-dd'),
      weekday: Number(Utilities.formatDate(d, CONFIG.TZ, 'u')) <= 5,
      dow: Number(Utilities.formatDate(d, CONFIG.TZ, 'u')),
      dom: Number(Utilities.formatDate(d, CONFIG.TZ, 'd')),
    });
  }

  // One verdict per area, worked out once per run.
  const verdicts = {};
  const forArea = (a) => {
    const id = validArea_(a);
    if (!verdicts[id]) {
      const v = verdict_(id);
      const fresh = !!(v && Date.now() - Date.parse(v.at) < 45 * 60 * 1000);
      verdicts[id] = { v, fresh, msg: fresh ? v.sms : 'Wash Watch couldn\'t get fresh data just now. Check the app before you go.' };
    }
    return verdicts[id];
  };

  // Push notifications (ntfy): each phone has its own private topic and schedule.
  const ps = pushSheet_();
  ps.getDataRange().getValues().slice(1).forEach((r, i) => {
    const [topic, times, days, mode, lastSent, , pArea] = r;
    for (const m of minutes) {
      const key = `${m.day} ${m.hhmm}`;
      if (lastSent === key || !String(times).split(',').includes(m.hhmm) || !dueOn_(String(days), m)) continue;
      ps.getRange(i + 2, 5).setValue(key);
      const { v, fresh, msg } = forArea(pArea);
      if (!(mode === 'off' && fresh && !v.off)) ntfy_(String(topic), v, msg);
    }
  });

  // Texts, within each person's daily limit and the overall daily budget.
  const sh = sheet_();
  const rows = sh.getDataRange().getValues().slice(1);
  rows.forEach((r, i) => {
    const phone = String(r[C.phone - 1]);
    if (r[C.verified - 1] !== true) return;
    const limit = r[C.key - 1] ? keyLimit_(String(r[C.key - 1])) || CONFIG.FREE_PER_DAY : CONFIG.FREE_PER_DAY;
    for (const m of minutes) {
      const key = `${m.day} ${m.hhmm}`;
      if (r[C.lastSent - 1] === key || !String(r[C.times - 1]).split(',').includes(m.hhmm)) continue;
      if (!dueOn_(String(r[C.days - 1]), m)) continue;
      sh.getRange(i + 2, C.lastSent).setValue(key);
      r[C.lastSent - 1] = key;
      const { v, fresh, msg } = forArea(r[C.area - 1]);
      if (r[C.mode - 1] === 'off' && fresh && !v.off) continue;
      let count = r[C.sentDay - 1] === m.day ? Number(r[C.sentCount - 1]) || 0 : 0;
      if (count >= limit) continue;
      if (!text_(phone, msg)) continue;
      count += 1;
      r[C.sentDay - 1] = m.day; r[C.sentCount - 1] = count;
      sh.getRange(i + 2, C.sentDay, 1, 2).setValues([[m.day, count]]);
    }
  });
}

// The verdict, computed here with the app's own rules (bundled in WashWatch.gs).
// Cached 4 minutes. Falls back to the copy GitHub publishes if computing fails.
function computeVerdict_(area) {
  const all = computeVerdicts_();
  return all ? all[validArea_(area)] : null;
}
function computeVerdicts_() {
  const cache = CacheService.getScriptCache();
  const hit = cache.get('verdicts');
  if (hit) return JSON.parse(hit);
  if (typeof evaluate !== 'function') return null; // Code.gs on its own, without the bundled engine
  const urls = sourceUrls(PropertiesService.getScriptProperties().getProperty('USGS_API_KEY'));
  const sites = Object.keys(urls.usgs);
  const ua = { 'User-Agent': 'WashWatch/1.0 (github.com/godfather38/floodplain)' };
  const reqs = [
    ...sites.map((s) => ({ url: urls.usgs[s], muteHttpExceptions: true, headers: ua })),
    { url: urls.closures, muteHttpExceptions: true, headers: ua },
    { url: urls.rain, muteHttpExceptions: true, headers: ua },
    { url: urls.stream, muteHttpExceptions: true, headers: ua },
    { url: urls.nws, muteHttpExceptions: true, headers: { ...ua, Accept: 'application/geo+json' } },
  ];
  const res = UrlFetchApp.fetchAll(reqs).map((r) => {
    if (r.getResponseCode() !== 200) return null;
    try { return JSON.parse(r.getContentText()); } catch (err) { return null; }
  });
  const now = Date.now();
  const usgs = Object.fromEntries(sites.map((s, i) => [s, res[i]]));
  const [closures, rain, stream, nws] = res.slice(sites.length);
  const alert = rain && stream ? alertSnapshot(rain.data, stream.data, now) : null;
  const out = {};
  for (const id of AREA_IDS) {
    const v = evaluate({ now, usgs, closures, alert, nws, routes: ROUTE_FEATURES }, id);
    out[id] = { at: v.at, text: v.text, sms: v.sms, spoken: v.spoken, off: v.off, title: v.title };
  }
  cache.put('verdicts', JSON.stringify(out), 240);
  if (alert) cache.put('alert', JSON.stringify(alert), 300);
  return out;
}

function verdict_(area) {
  try { const v = computeVerdict_(area); if (v) return v; } catch (err) { /* fall back below */ }
  if (validArea_(area) !== 'avra') return null; // GitHub's backup copy covers Avra Valley only
  const cache = CacheService.getScriptCache();
  const hit = cache.get('verdict');
  if (hit) return JSON.parse(hit);
  try {
    const t = UrlFetchApp.fetch(CONFIG.VERDICT_URL, { muteHttpExceptions: true }).getContentText();
    const v = JSON.parse(t);
    cache.put('verdict', t, 60);
    return v;
  } catch (err) {
    return null;
  }
}

function ntfy_(topic, v, msg) {
  UrlFetchApp.fetch(topic.startsWith('http') ? topic : `https://ntfy.sh/${topic}`, {
    method: 'post', payload: msg, muteHttpExceptions: true,
    headers: { Title: v && v.title ? v.title : 'Wash Watch', Click: CONFIG.APP_URL, Tags: 'droplet' },
  });
}

// Verizon shutdown notices: heads-up on HEADS_UP, final on ENDED (subscribers + owner).
function sunset_(today, props) {
  const stages = [
    [CONFIG.HEADS_UP, 'sunset_headsup', 'Heads-up from Wash Watch: Verizon ends email-to-text on March 31, 2027, so these texts stop then. Free phone alerts keep working: ' + CONFIG.APP_URL + '#/alerts'],
    [CONFIG.ENDED, 'sunset_ended', 'Wash Watch: Verizon has ended email-to-text, so these texts have stopped. Free phone alerts: ' + CONFIG.APP_URL + '#/alerts'],
  ];
  for (const [date, flag, msg] of stages) {
    if (today < date || props.getProperty(flag)) continue;
    props.setProperty(flag, today);
    const rows = sheet_().getDataRange().getValues().slice(1).filter((r) => r[4] === true);
    rows.forEach((r) => text_(String(r[0]), msg));
    MailApp.sendEmail(Session.getEffectiveUser().getEmail(), 'Wash Watch: Verizon email-to-text ' + (flag === 'sunset_ended' ? 'has ended' : 'ends March 31, 2027'),
      msg + '\n\nSubscribers notified: ' + rows.length + '.');
  }
}

// ---------- helpers ----------
// Twilio credentials come from Script properties (TWILIO_SID, TWILIO_TOKEN, optional
// TWILIO_FROM) or from a private Secrets.gs file in the same Apps Script project that
// defines `const TWILIO = { SID, TOKEN, FROM }`. Neither is ever committed to GitHub.
// Without a FROM number, the account's first Twilio number is looked up and remembered.
function twilio_() {
  const p = PropertiesService.getScriptProperties();
  const file = typeof TWILIO === 'object' && TWILIO ? TWILIO : {};
  const sid = p.getProperty('TWILIO_SID') || file.SID;
  const token = p.getProperty('TWILIO_TOKEN') || file.TOKEN;
  if (!sid || !token) return null;
  let from = p.getProperty('TWILIO_FROM') || file.FROM;
  if (!from) {
    try {
      const r = UrlFetchApp.fetch(`https://api.twilio.com/2010-04-01/Accounts/${sid}/IncomingPhoneNumbers.json?PageSize=1`, {
        muteHttpExceptions: true, headers: { Authorization: 'Basic ' + Utilities.base64Encode(`${sid}:${token}`) },
      });
      const n = JSON.parse(r.getContentText()).incoming_phone_numbers?.[0]?.phone_number;
      if (n) { from = n; p.setProperty('TWILIO_FROM', n); }
    } catch (err) { from = null; }
  }
  return from ? { sid, token, from } : null;
}
// Sends one text. Returns false when the overall daily budget is used up.
// Codes (isCode) still count toward the budget but are always attempted while any is left.
function text_(phone, body, isCode) {
  const props = PropertiesService.getScriptProperties();
  const today = today_();
  const [day, n] = String(props.getProperty('budget') || '').split(' ');
  const used = day === today ? Number(n) || 0 : 0;
  if (used >= CONFIG.DAILY_TEXT_BUDGET) {
    if (!props.getProperty('budget_warned_' + today)) {
      props.setProperty('budget_warned_' + today, '1');
      MailApp.sendEmail(Session.getEffectiveUser().getEmail(), 'Wash Watch: daily text budget reached',
        `All ${CONFIG.DAILY_TEXT_BUDGET} texts for ${today} are used. More texts wait until tomorrow. Change DAILY_TEXT_BUDGET in the script to raise it.`);
    }
    return false;
  }
  props.setProperty('budget', `${today} ${used + 1}`);
  void isCode;
  const t = twilio_();
  if (t) {
    UrlFetchApp.fetch(`https://api.twilio.com/2010-04-01/Accounts/${t.sid}/Messages.json`, {
      method: 'post', muteHttpExceptions: true,
      headers: { Authorization: 'Basic ' + Utilities.base64Encode(`${t.sid}:${t.token}`) },
      payload: { To: `+1${phone}`, From: t.from, Body: body.slice(0, 320) },
    });
    return true;
  }
  if (MailApp.getRemainingDailyQuota() < 1) return false;
  MailApp.sendEmail({ to: `${phone}@${CONFIG.GATEWAY}`, subject: '', body: body.slice(0, 300), name: 'Wash Watch' });
  return true;
}
function sheet_() {
  const props = PropertiesService.getScriptProperties();
  let id = props.getProperty('sheet_id');
  let ss = null;
  if (id) { try { ss = SpreadsheetApp.openById(id); } catch (err) { ss = null; } }
  if (!ss) {
    ss = SpreadsheetApp.create('Wash Watch text subscribers (private)');
    props.setProperty('sheet_id', ss.getId());
    ss.getSheets()[0].setName('subscribers');
    ss.getSheets()[0].appendRow(HEADER);
  }
  return ss.getSheets()[0];
}
function keysSheet_() {
  const ss = sheet_().getParent();
  let k = ss.getSheetByName('keys');
  if (!k) {
    k = ss.insertSheet('keys');
    k.appendRow(KEYS_HEADER);
    k.appendRow(['example-key-change-me', 4, 'delete this row; add one per person you give more texts']);
  }
  return k;
}
function today_() { return Utilities.formatDate(new Date(), CONFIG.TZ, 'yyyy-MM-dd'); }
function findRow_(sh, phone) {
  const col = sh.getRange(1, 1, Math.max(sh.getLastRow(), 1), 1).getValues();
  for (let i = 1; i < col.length; i++) if (String(col[i][0]) === phone) return i + 1;
  return 0;
}
function newToday_() {
  const today = Utilities.formatDate(new Date(), CONFIG.TZ, 'yyyy-MM-dd');
  return sheet_().getDataRange().getValues().slice(1)
    .filter((r) => r[C.created - 1] instanceof Date && Utilities.formatDate(r[8], CONFIG.TZ, 'yyyy-MM-dd') === today).length;
}
function ensureTrigger_() {
  if (!ScriptApp.getProjectTriggers().some((t) => t.getHandlerFunction() === 'tick')) {
    ScriptApp.newTrigger('tick').timeBased().everyMinutes(1).create();
  }
}
// Days are "w:1,2,3,4,5" (ISO weekdays, 1 = Monday) or "m:1,15" (days of the month).
// Older values "wd" and "all" still work.
function validDays_(d) {
  const m = /^([wm]):([\d,]+)$/.exec(String(d || ''));
  if (!m) return d === 'all' ? 'w:1,2,3,4,5,6,7' : 'w:1,2,3,4,5';
  const max = m[1] === 'w' ? 7 : 31;
  const list = [...new Set(m[2].split(',').map(Number))].filter((n) => n >= 1 && n <= max).sort((a, b) => a - b);
  return list.length ? `${m[1]}:${list.join(',')}` : 'w:1,2,3,4,5';
}
function dueOn_(days, m) {
  if (days === 'all') return true;
  if (days === 'wd' || !days) return m.weekday;
  const [kind, list] = days.split(':');
  const nums = String(list || '').split(',').map(Number);
  return kind === 'm' ? nums.includes(m.dom) : nums.includes(m.dow);
}
function daysLabel_(days) {
  const d = validDays_(days);
  const [kind, list] = d.split(':');
  const nums = list.split(',').map(Number);
  const ord = (n) => n + (n % 10 === 1 && n !== 11 ? 'st' : n % 10 === 2 && n !== 12 ? 'nd' : n % 10 === 3 && n !== 13 ? 'rd' : 'th');
  if (kind === 'm') return 'on the ' + nums.map(ord).join(', ') + ' of each month';
  const names = ['', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  if (nums.join() === '1,2,3,4,5') return 'weekdays';
  if (nums.length === 7) return 'every day';
  return nums.map((n) => names[n]).join(', ');
}

// ---------- push notifications (ntfy) ----------
function pushSheet_() {
  const ss = sheet_().getParent();
  let p = ss.getSheetByName('push');
  if (!p) { p = ss.insertSheet('push'); p.appendRow(['topic', 'times', 'days', 'mode', 'last_sent', 'created', 'area']); }
  return p;
}
function push_(b) {
  const topic = String(b.topic || '');
  if (!/^washwatch-[a-z0-9]{8,32}$/.test(topic)) return { ok: false, error: 'bad topic' };
  const times = [...new Set((b.times || []).map(String))].filter(validTime_).slice(0, CONFIG.MAX_TIMES);
  if (!times.length) return { ok: false, error: 'Pick at least one time.' };
  const values = [topic, times.join(','), validDays_(b.days), b.mode === 'off' ? 'off' : 'all'];
  const ps = pushSheet_();
  const rows = ps.getDataRange().getValues();
  const i = rows.findIndex((r, k) => k > 0 && r[0] === topic);
  if (i > 0) { ps.getRange(i + 1, 1, 1, 4).setValues([values]); ps.getRange(i + 1, 7).setValue(validArea_(b.area)); } else {
    const today = today_();
    const added = rows.slice(1).filter((r) => r[5] instanceof Date && Utilities.formatDate(r[5], CONFIG.TZ, 'yyyy-MM-dd') === today).length;
    if (added >= 300) return { ok: false, error: 'Too many new sign-ups today. Try tomorrow.' };
    ps.appendRow([...values, '', new Date(), validArea_(b.area)]);
  }
  return { ok: true, step: 'saved', days: daysLabel_(values[2]) };
}
function pushStop_(b) {
  const ps = pushSheet_();
  const rows = ps.getDataRange().getValues();
  const i = rows.findIndex((r, k) => k > 0 && r[0] === String(b.topic || ''));
  if (i > 0) ps.deleteRow(i + 1);
  return { ok: true, step: 'stopped' };
}

function validTime_(t) {
  const m = /^(\d{2}):(\d{2})$/.exec(t);
  return !!m && Number(m[1]) < 24 && Number(m[2]) < 60;
}
function label_(t) {
  const [h, m] = t.split(':').map(Number);
  return `${((h + 11) % 12) + 1}:${pad_(m)} ${h < 12 ? 'AM' : 'PM'}`;
}
function pad_(n) { return String(n).padStart(2, '0'); }
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }

